<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>friday_ros2</name>
  <version>0.1.0</version>
  <description>Meta-package for public Friday ROS 2 packages.</description>
  <maintainer email="opensource@holiday-robotics.com">Holiday Robotics Open Source</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>friday_description</exec_depend>
  <exec_depend>friday_manipulation</exec_depend>
  <exec_depend>ros2_interfaces_public</exec_depend>
  <exec_depend>friday_teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
