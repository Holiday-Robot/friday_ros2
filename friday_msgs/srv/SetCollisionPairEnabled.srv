# Robot part names (RobotSpec joint-group names, e.g. "left_arm", "right_hand"). The
# order of part_a / part_b does not matter. A pair without collision-avoidance body
# pairs returns RESULT_INVALID_ARGUMENT and lists the valid pairs in message.
string<=64 part_a
string<=64 part_b
# Requested enable state of every body pair behind this part pair. The resulting state
# is published on holiday/control/avoidance/enabled.
bool enabled
---
uint16 RESULT_SUCCESS=0
uint16 RESULT_INVALID_ARGUMENT=1
uint16 RESULT_NOT_READY=2
uint16 RESULT_BUSY=3
uint16 RESULT_TIMEOUT=4
uint16 RESULT_HARDWARE_ERROR=5
uint16 RESULT_PERMISSION_DENIED=6
uint16 RESULT_INTERNAL_ERROR=255

bool success
uint16 result_code
string<=128 message
