# Set the low-battery warning threshold. Platform-specific limits may reject a value.
uint8 threshold # 0..100 percent state of charge.
---
uint16 RESULT_SUCCESS=0
uint16 RESULT_INVALID_ARGUMENT=1
uint16 RESULT_NOT_READY=2
uint16 RESULT_BUSY=3
uint16 RESULT_TIMEOUT=4
uint16 RESULT_HARDWARE_ERROR=5
uint16 RESULT_PERMISSION_DENIED=6
uint16 RESULT_INTERNAL_ERROR=255

bool success # True when the driver reports successful writes; use GetBatteryAlarm to read back.
uint16 result_code
string<=128 message
