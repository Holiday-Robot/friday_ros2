<mujoco model="FM26A">
  <compiler angle="radian" autolimits="true" meshdir="../meshes"/>
  <option integrator="implicitfast"/>
  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <!-- self-collision groups (contype/conaffinity bits):
   bit 0: environment / ground
   bit 1: waist
   bit 2: left_arm
   bit 3: right_arm
   bit 4: head
   bit 5: left_hand
   bit 6: right_hand
   bit 7: mobile_base
-->
    <default class="head">
      <geom group="3" contype="17" conaffinity="108"/>
    </default>
    <default class="left_arm">
      <geom group="3" contype="5" conaffinity="222"/>
    </default>
    <default class="left_hand">
      <geom group="3" contype="33" conaffinity="218"/>
    </default>
    <default class="mobile_base">
      <geom group="3" contype="129" conaffinity="108"/>
    </default>
    <default class="no_self_collision">
      <geom group="3" contype="1" conaffinity="0"/>
    </default>
    <default class="right_arm">
      <geom group="3" contype="9" conaffinity="190"/>
    </default>
    <default class="right_hand">
      <geom group="3" contype="65" conaffinity="182"/>
    </default>
    <default class="waist">
      <geom group="3" contype="3" conaffinity="108"/>
    </default>
  </default>
